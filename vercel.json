{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://minescout-api.bharosilo.com/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/spa/app.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/spa/app.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
